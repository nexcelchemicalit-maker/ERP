{
  "name": "nexcel-erp-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply nexcel-erp-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply nexcel-erp-db --remote",
    "db:seed:local": "wrangler d1 execute nexcel-erp-db --local --file=./seed.sql",
    "db:reset": "npm run db:migrate:local && npm run db:seed:local",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20241218.0",
    "typescript": "5.7.2",
    "wrangler": "3.95.0"
  }
}
